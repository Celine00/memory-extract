#!/bin/sh

set -eu

# Convenience wrapper for the repo-local layered memory pilot.
# Defaults:
# - PROJECT_PATH: current working directory
# - OUTPUT_DIR: ./output
# - LLM_BACKEND: codex-cli
# - LLM_MODEL: unset (use backend default)
# - SOURCE_PLATFORMS: codex,claude (both platforms scanned by default)

PROJECT_PATH="${PROJECT_PATH:-$PWD}"
OUTPUT_DIR="${OUTPUT_DIR:-./output}"
LLM_BACKEND="${LLM_BACKEND:-codex-cli}"

if [ -n "${LLM_MODEL:-}" ]; then
  exec python3 -m memory_promotion.cli capture \
    --project "$PROJECT_PATH" \
    --output-dir "$OUTPUT_DIR" \
    --llm-backend "$LLM_BACKEND" \
    --llm-model "$LLM_MODEL" \
    "$@"
fi

exec python3 -m memory_promotion.cli capture \
  --project "$PROJECT_PATH" \
  --output-dir "$OUTPUT_DIR" \
  --llm-backend "$LLM_BACKEND" \
  "$@"
